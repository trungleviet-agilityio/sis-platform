# Non-secret project identity. SIS_PROJECT_PREFIX is checked against platform.yaml project.prefix (ADR 0002, M7).
SIS_PROJECT_PREFIX=exa
SIS_GITHUB_OWNER=example-owner
SIS_GITHUB_REPO=example-app
# The GitHub Projects board the sis-team agents may write to (ADR 0001, B6). Fill in once the board exists.
SIS_BOARD_OWNER=example-owner
SIS_BOARD_PROJECT=1
