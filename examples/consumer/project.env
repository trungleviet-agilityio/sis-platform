# Non-secret project identity. The resolve step of every reusable Terraform and smoke workflow fails unless
# SIS_PROJECT_PREFIX is set once and equals platform.yaml project.prefix (ADR 0002, M7; scripts/platform/resolve.py).
SIS_PROJECT_PREFIX=exa
SIS_GITHUB_OWNER=example-owner
SIS_GITHUB_REPO=example-app
# The GitHub Projects board the sis-team agents may write to (ADR 0001, B6). Fill in once the board exists.
SIS_BOARD_OWNER=example-owner
SIS_BOARD_PROJECT=1
