# Terraform CLI configuration for the reusable plan and apply jobs (TF_CLI_CONFIG_FILE). Providers install only
# directly from the public registry, and only the hashicorp namespace. An explicit provider_installation block also
# turns off the implied local mirror directories, so a provider planted on the runner or in the caller repository
# is never used. scripts/tf/resolved-sources.sh then checks the lock file and the modules init resolved.
provider_installation {
  direct {
    include = ["registry.terraform.io/hashicorp/*"]
  }
}
