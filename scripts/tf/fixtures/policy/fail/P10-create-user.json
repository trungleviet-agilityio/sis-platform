{
  "documents": [
    {
      "name": "P10-create-user",
      "policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": "iam:CreateUser",
            "Resource": "arn:aws:iam::123456789012:user/*"
          }
        ]
      }
    }
  ],
  "boundary_arn": "arn:aws:iam::123456789012:policy/sis-dev-workload-boundary"
}
