{
  "documents": [
    {
      "name": "P11-ecr-repository-glob",
      "policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": "ecr:PutLifecyclePolicy",
            "Resource": "arn:aws:ecr:ap-southeast-1:123456789012:repository/sis-*"
          }
        ]
      }
    }
  ],
  "boundary_arn": "arn:aws:iam::123456789012:policy/sis-dev-workload-boundary"
}
