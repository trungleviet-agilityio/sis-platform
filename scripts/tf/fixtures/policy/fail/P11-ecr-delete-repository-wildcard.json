{
  "documents": [
    {
      "name": "P11-ecr-delete-repository-wildcard",
      "policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "ecr:DeleteRepository"
            ],
            "Resource": "arn:aws:ecr:*:*:repository/*"
          }
        ]
      }
    }
  ],
  "boundary_arn": "arn:aws:iam::123456789012:policy/sis-dev-workload-boundary"
}
