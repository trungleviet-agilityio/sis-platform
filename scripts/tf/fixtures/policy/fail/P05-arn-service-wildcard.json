{
  "documents": [
    {
      "name": "P05-arn-service-wildcard",
      "policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": "lambda:InvokeFunction",
            "Resource": "arn:aws:*:*:*:*"
          }
        ]
      }
    }
  ],
  "boundary_arn": "arn:aws:iam::123456789012:policy/sis-dev-workload-boundary"
}
