{
  "documents": [
    {
      "name": "P06-stringlike-boundary",
      "policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": "iam:CreateRole",
            "Resource": "arn:aws:iam::123456789012:role/sis-dev-app-*",
            "Condition": {
              "StringLike": {
                "iam:PermissionsBoundary": "*"
              }
            }
          }
        ]
      }
    }
  ],
  "boundary_arn": "arn:aws:iam::123456789012:policy/sis-dev-workload-boundary"
}
