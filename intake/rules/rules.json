{
  "version": 1,
  "rules": [
    {"id": "V01", "rule": "`canary` or `linear` requires `rollback: alarm`", "severity": "E", "pillars": ["REL", "OPS"], "wa_refs": ["OPS06-BP04", "REL08-BP05"]},
    {"id": "V02", "rule": "`canary`/`linear` need `steps` rising and ending at 100, and `bake_minutes` >= 1", "severity": "E", "pillars": ["REL"], "wa_refs": ["OPS06-BP03"], "params": {"strategies": ["canary", "linear"], "min_bake_minutes": 1}},
    {"id": "V03", "rule": "`delivery: gitops` only for `eks-workload`", "severity": "E", "pillars": ["OPS"], "wa_refs": ["OPS06-BP03"], "params": {"gitops_runtimes": ["eks-workload"]}},
    {"id": "V04", "rule": "(runtime, strategy, engine) must be in the compatibility matrix", "severity": "E", "pillars": ["OPS", "REL"], "wa_refs": ["REL08-BP05"]},
    {"id": "V05", "rule": "canary, linear or blue-green on ecs-fargate or ec2-asg need `front_door: alb`", "severity": "E", "pillars": ["REL"], "wa_refs": ["OPS06-BP03"], "params": {"runtimes": ["ecs-fargate", "ec2-asg"], "strategies": ["canary", "linear", "blue-green"]}},
    {"id": "V06", "rule": "ALB needed and `budget.monthly_usd` < 40", "severity": "W", "pillars": ["COST"], "wa_refs": ["COST02-BP05"], "params": {"threshold_usd": 40}},
    {"id": "V07", "rule": "`blue-green` doubles capacity during a deploy", "severity": "W", "pillars": ["COST", "SUS"], "wa_refs": ["SUS02-BP01"]},
    {"id": "V08", "rule": "Lambda runtime with `max_duration_seconds` > 900, `max_payload_mb` > 6, or `needs` containing gpu, os or licence", "severity": "E", "pillars": ["PERF"], "wa_refs": ["PERF01", "PERF02-BP01"], "params": {"max_duration_seconds": 900, "max_payload_mb": 6, "needs": ["gpu", "os", "licence"]}},
    {"id": "V09", "rule": "`front_door: http-api` with `max_duration_seconds` > 29", "severity": "E", "pillars": ["PERF", "REL"], "wa_refs": ["PERF02-BP02"], "params": {"max_duration_seconds": 29}},
    {"id": "V10", "rule": "A 12-digit number anywhere in the manifest, including placeholders", "severity": "E", "pillars": ["SEC"], "wa_refs": ["SEC01-BP06"]},
    {"id": "V11", "rule": "A `prod` env needs `promote_from` (one artifact promoted by digest)", "severity": "E", "pillars": ["SEC", "REL"], "wa_refs": ["SEC11-BP06", "REL08-BP04"]},
    {"id": "V12", "rule": "`database.kind != none` and a strategy that runs two versions at once (all except all-at-once) needs `database.schema_change: expand-contract`", "severity": "E", "pillars": ["REL"], "wa_refs": ["REL08-BP02"]},
    {"id": "V13", "rule": "`dr.rto_minutes` < 60 with `backup-restore`, or < 10 without warm-standby or multi-site", "severity": "W", "pillars": ["REL"], "wa_refs": ["REL13-BP01", "REL13-BP02"], "params": {"backup_restore_min_rto": 60, "other_min_rto": 10}},
    {"id": "V14", "rule": "`warm-standby` or `multi-site` with `budget.monthly_usd` < 100", "severity": "W", "pillars": ["COST", "REL"], "wa_refs": ["COST02-BP05"], "params": {"threshold_usd": 100}},
    {"id": "V15", "rule": "`eks-workload` with `budget.monthly_usd` < 100 (control plane cost)", "severity": "W", "pillars": ["COST"], "wa_refs": ["COST05"], "params": {"threshold_usd": 100}},
    {"id": "V16", "rule": "`scale_to_zero` or `fargate_spot` on prod", "severity": "W", "pillars": ["REL"], "wa_refs": ["REL10"]},
    {"id": "V17", "rule": "Runtime adapter or `ci.provider: codepipeline` not built yet", "severity": "W", "pillars": ["OPS"], "wa_refs": ["OPS07"]},
    {"id": "V18", "rule": "`prod` with `rollback: manual` and a strategy other than all-at-once", "severity": "W", "pillars": ["OPS"], "wa_refs": ["OPS06-BP01"]}
  ]
}
