{
  "version": 2,
  "note": "Capabilities as data (ADR 0002 M9). Every built flag is false in Phase 1; the phase that builds an adapter flips its flags. two_versions_live lists the strategies that run two versions at once.",
  "runtimes": {
    "lambda-web": {
      "family": "lambda",
      "strategies": ["all-at-once", "canary", "linear"],
      "engines": ["pipeline", "codedeploy"],
      "auto_engine": "pipeline",
      "engine_strategies": {},
      "gradual_needs_alb": false,
      "gitops": false,
      "fixed_monthly_usd": 0,
      "two_versions_live": ["canary", "linear"],
      "env_flags": ["scale_to_zero"],
      "alarms": ["5xx-rate", "p95-latency", "throttles", "probe-failures"],
      "hints": {
        "rolling": "alias flip = all-at-once; use all-at-once, canary or linear",
        "blue-green": "alias flip = all-at-once; use all-at-once, canary or linear"
      },
      "built": {
        "runtime": false,
        "engines": {"pipeline": false, "codedeploy": false},
        "delivery": {"push": false, "gitops": false},
        "profiles": {"lambda-alias": false, "codedeploy-lambda": false}
      }
    },
    "lambda-events": {
      "family": "lambda",
      "strategies": ["all-at-once", "canary", "linear"],
      "engines": ["pipeline", "codedeploy"],
      "auto_engine": "pipeline",
      "engine_strategies": {},
      "gradual_needs_alb": false,
      "gitops": false,
      "fixed_monthly_usd": 0,
      "two_versions_live": ["canary", "linear"],
      "env_flags": ["scale_to_zero"],
      "alarms": ["errors", "throttles", "dlq-depth"],
      "hints": {
        "rolling": "alias flip = all-at-once; use all-at-once, canary or linear",
        "blue-green": "alias flip = all-at-once; use all-at-once, canary or linear"
      },
      "built": {
        "runtime": false,
        "engines": {"pipeline": false, "codedeploy": false},
        "delivery": {"push": false, "gitops": false},
        "profiles": {"lambda-alias": false, "codedeploy-lambda": false}
      }
    },
    "ecs-fargate": {
      "family": "ecs",
      "strategies": ["all-at-once", "rolling", "canary", "linear", "blue-green"],
      "engines": ["ecs-native", "codedeploy", "pipeline"],
      "auto_engine": "ecs-native",
      "engine_strategies": {"pipeline": ["rolling"]},
      "gradual_needs_alb": true,
      "gitops": false,
      "fixed_monthly_usd": 0,
      "two_versions_live": ["rolling", "canary", "linear", "blue-green"],
      "env_flags": ["scale_to_zero", "fargate_spot"],
      "alarms": ["5xx-rate", "p95-latency", "unhealthy-hosts", "probe-failures"],
      "hints": {},
      "built": {
        "runtime": false,
        "engines": {"ecs-native": false, "codedeploy": false, "pipeline": false},
        "delivery": {"push": false, "gitops": false},
        "profiles": {"ecs-native": false, "codedeploy-ecs": false, "ecs-service-update": false}
      }
    },
    "ec2-asg": {
      "family": "ec2",
      "strategies": ["rolling", "canary", "blue-green"],
      "engines": ["asg", "codedeploy"],
      "auto_engine": "asg",
      "engine_strategies": {},
      "gradual_needs_alb": true,
      "gitops": false,
      "fixed_monthly_usd": 0,
      "two_versions_live": ["rolling", "canary", "blue-green"],
      "env_flags": ["scale_to_zero"],
      "alarms": ["5xx-rate", "p95-latency", "unhealthy-hosts", "instance-status-check", "probe-failures"],
      "hints": {
        "all-at-once": "an ASG deploys by instance refresh; use rolling, canary or blue-green"
      },
      "built": {
        "runtime": false,
        "engines": {"asg": false, "codedeploy": false},
        "delivery": {"push": false, "gitops": false},
        "profiles": {"asg-instance-refresh": false, "codedeploy-ec2": false}
      }
    },
    "eks-workload": {
      "family": "eks",
      "strategies": ["rolling", "canary", "blue-green"],
      "engines": ["argo-rollouts"],
      "auto_engine": "argo-rollouts",
      "engine_strategies": {},
      "gradual_needs_alb": false,
      "gitops": true,
      "fixed_monthly_usd": 73,
      "two_versions_live": ["rolling", "canary", "blue-green"],
      "env_flags": [],
      "alarms": ["5xx-rate", "p95-latency", "pod-restarts", "probe-failures"],
      "hints": {
        "all-at-once": "Argo Rollouts releases gradually; use rolling, canary or blue-green"
      },
      "built": {
        "runtime": false,
        "engines": {"argo-rollouts": false},
        "delivery": {"push": false, "gitops": false},
        "profiles": {"argo-rollouts": false}
      }
    }
  },
  "deploy_role_profiles": {
    "lambda-web:pipeline": "lambda-alias",
    "lambda-web:codedeploy": "codedeploy-lambda",
    "lambda-events:pipeline": "lambda-alias",
    "lambda-events:codedeploy": "codedeploy-lambda",
    "ecs-fargate:ecs-native": "ecs-native",
    "ecs-fargate:codedeploy": "codedeploy-ecs",
    "ecs-fargate:pipeline": "ecs-service-update",
    "ec2-asg:asg": "asg-instance-refresh",
    "ec2-asg:codedeploy": "codedeploy-ec2",
    "eks-workload:argo-rollouts": "argo-rollouts"
  }
}
