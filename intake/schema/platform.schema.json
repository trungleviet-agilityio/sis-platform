{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sis-platform:platform:1",
  "title": "sis-platform manifest (platform.yaml), schema_version 1",
  "description": "Uses only the keyword subset interpreted by sis_intake/schema.py. Account labels only, never account IDs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "platform", "runtime", "envs"],
  "properties": {
    "schema_version": {"const": 1},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "prefix"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$"},
        "prefix": {"type": "string", "pattern": "^[a-z][a-z0-9]{1,7}$"}
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shape": {"enum": ["web", "events", "worker", "batch"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "health_path": {"type": "string", "pattern": "^/"},
        "max_duration_seconds": {"type": "integer", "minimum": 1},
        "max_payload_mb": {"type": "integer", "minimum": 1},
        "needs": {"type": "array", "items": {"enum": ["gpu", "os", "licence"]}}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["lambda-web", "lambda-events", "ecs-fargate", "ec2-asg", "eks-workload"]},
        "arch": {"enum": ["arm64", "x86_64"]},
        "front_door": {"enum": ["http-api", "function-url", "cloudfront", "alb", "none"]}
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {"enum": ["github-actions", "codepipeline"]}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["monthly_usd"],
      "properties": {
        "monthly_usd": {"type": "integer", "minimum": 0}
      }
    },
    "dr": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {"enum": ["backup-restore", "pilot-light", "warm-standby", "multi-site"]},
        "rto_minutes": {"type": "integer", "minimum": 0},
        "rpo_minutes": {"type": "integer", "minimum": 0}
      }
    },
    "compliance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data_class": {"enum": ["public", "internal", "confidential", "regulated"]},
        "kms_cmk": {"type": "boolean"}
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["none", "postgres", "mysql", "dynamodb", "other"]},
        "schema_change": {"enum": ["expand-contract", "in-place"]}
      }
    },
    "envs": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/env"}
    }
  },
  "$defs": {
    "env": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account", "region"],
      "properties": {
        "account": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "region": {"type": "string", "pattern": "^[a-z]{2}(-[a-z]+)+-[0-9]$"},
        "delivery": {"enum": ["push", "gitops"]},
        "promote_from": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "scale_to_zero": {"type": "boolean"},
        "fargate_spot": {"type": "boolean"},
        "release": {"$ref": "#/$defs/release"}
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {"enum": ["all-at-once", "rolling", "canary", "linear", "blue-green"]},
        "steps": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1, "maximum": 100}},
        "bake_minutes": {"type": "integer", "minimum": 0},
        "rollback": {"enum": ["alarm", "health", "manual"]},
        "engine": {"enum": ["auto", "pipeline", "codedeploy", "ecs-native", "argo-rollouts", "asg"]}
      }
    }
  }
}
